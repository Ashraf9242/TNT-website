---
import {href,ui,labels,whatsappHref,pendingCollections,processSteps,type Lang} from '../data/site';
import {about,why,whyDetails,text} from '../data/content';
import {corp} from '../data/corporate';
import AcTypes from './AcTypes.astro';
import HeroBackground from './HeroBackground.astro';
import Faq from './Faq.astro';import Projects from './Projects.astro';import Photo from './Photo.astro';import Stats from './Stats.astro';import Services from './Services.astro';import Clients from './Clients.astro';
interface Props{lang:Lang}const {lang}=Astro.props;const ar=lang==='ar';const t=ui[lang];const {corpHero,corpWhatsappText}=corp(lang);
---
<section class="hero"><HeroBackground/><div class="hero-scrim" aria-hidden="true"></div><div class="wrap hero-inner"><h1>{ar?text(1,1):'TNT Air Conditioning'}</h1><p>{ar?text(7,16).replace('تركيب','صيانة'):'Maintenance of all types of AC systems to approved technical standards.'}</p><p class="hero-trust">{ar?'تأسست في عمان بإدارة عمانية':'Founded in Oman under Omani management'}</p></div></section>
<section class="section"><div class="wrap"><div class="intro-grid"><div><h2>{ar?text(2,0):'Who we are'}</h2><a class="text-link" href={href(lang,'about')}>{labels[lang].about}<span aria-hidden="true">↗</span></a></div><p class="lead">{about(lang)}</p></div><Stats lang={lang}/></div></section>
<section class="section white"><div class="wrap"><div class="section-heading"><div><h2>{ar?text(9,0).replace(':',''):'Types of ACs we work with'}</h2></div><a class="text-link" href={href(lang,'systems')}>{t.allSystems}<span aria-hidden="true">↗</span></a></div><AcTypes lang={lang} compact/></div></section>
<section class="section contract-section"><div class="wrap contract-grid"><div><h2>{labels[lang].contracts}</h2><p>{corpHero.title.join(' ')}</p><ul class="check-list">{corpHero.points.slice(0,3).map(s=><li>{s}</li>)}</ul><div class="actions" style="margin-top:30px"><a class="btn-96" href={href(lang,'contracts')}><span>{t.details}</span></a><a class="text-link" href={whatsappHref(corpWhatsappText)}>{corpHero.cta} ↗</a></div></div><img class="contract-photo" src="/images/ac/chiller.webp" width="800" height="600" loading="lazy" decoding="async" alt={ar?'وحدات تشيلر على سطح مبنى':'Chiller units on a building rooftop'}/></div></section>
<section class="section"><div class="wrap"><div class="section-heading"><div><h2>{ar?text(7,14):'Our main services'}</h2></div><a class="text-link" href={href(lang,'services')}>{t.allServices}<span aria-hidden="true">↗</span></a></div><Services lang={lang}/></div></section>
<section class="section soft"><div class="wrap why-grid"><h2>{text(5,ar?6:7)}</h2><div class="why-items">{why(lang).slice(0,4).map((s,i)=><div class="why-item"><span>{String(i+1).padStart(2,'0')}</span><h3>{s}</h3><p>{whyDetails(lang)[i]}</p></div>)}</div><div class="why-more"><a class="text-link" href={href(lang,'about')}>{ar?'كل أسباب اختيار TNT':'All reasons to choose TNT'}<span aria-hidden="true">↗</span></a></div></div></section>
<section class="section"><div class="wrap"><div class="section-heading process-heading"><h2>{ar?'من الطلب إلى التنفيذ':'From request to execution'}</h2></div><ol class="process-grid">{processSteps[lang].map((s,i)=><li class="process-step"><span class="process-number">0{i+1}</span><h3>{s.title}</h3><p>{s.text}</p></li>)}</ol></div></section>
<section class="section soft"><div class="wrap"><div class="section-heading"><div><h2>{ar?text(6,0):'Our clients'}</h2></div><a class="text-link" href={href(lang,'clients')}>{t.details}<span aria-hidden="true">↗</span></a></div><Clients lang={lang} limit={10}/></div></section>

<Projects items={pendingCollections.projects} title={ar?'المشاريع':'Projects'}/><Faq items={pendingCollections.faqs} title={ar?'الأسئلة الشائعة':'Frequently asked questions'}/>
