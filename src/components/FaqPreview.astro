---
import {href, type Lang} from '../data/site';
import {featuredFaqs, faqCount} from '../data/faq';
import FaqItem from './FaqItem.astro';
interface Props { lang: Lang }
const {lang} = Astro.props;
const ar = lang === 'ar';
---
<section class="faq-preview" aria-labelledby="faq-preview-title">
  <header class="faq-unit">
    <span class="faq-unit-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9.5"/><path d="M9.5 9.2a2.6 2.6 0 1 1 3.6 2.4c-.7.3-1.1.9-1.1 1.7v.6M12 17h.01"/></svg></span>
    <div class="faq-preview-head">
      <h2 id="faq-preview-title">{ar ? 'قبل أن ترسل، قد تجد إجابتك هنا' : 'Before you message us, your answer may be here'}</h2>
      <p>{ar ? 'أكثر الأسئلة التي تصلنا يوميًا، مع إجاباتها.' : 'The questions we get most every day, with their answers.'}</p>
    </div>
    <span class="faq-unit-vent" aria-hidden="true"></span>
  </header>
  <div class="faq-list">{featuredFaqs(lang).map(item => <FaqItem item={item} lang={lang}/>)}</div>
  <a class="faq-preview-all" href={href(lang, 'faq')}>{ar ? `عرض جميع الأسئلة الشائعة (${faqCount})` : `View all FAQs (${faqCount})`} <span aria-hidden="true">←</span></a>
</section>
<div class="faq-preview-divider" role="presentation"><span>{ar ? 'لم تجد إجابتك؟ راسلنا مباشرة' : 'No answer? Message us directly'}</span></div>
