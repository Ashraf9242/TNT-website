---
// Grid of AC system types with photos. `compact` = smaller tiles with short names.
import {acTypes} from '../data/corporate';
import type {Lang} from '../data/site';
interface Props { lang: Lang; compact?: boolean }
const {lang, compact = false} = Astro.props;
---
<ul class:list={['ac-types', {'ac-types--compact': compact}]}>
  {acTypes(lang).map((t, i) => <li class="ac-type">
    <img src={`/images/ac/${t.key}.webp`} width="800" height="600" loading="lazy" decoding="async" alt={t.name}/>
    <span class="ac-type-name">{!compact && <b dir="ltr">{String(i + 1).padStart(2, '0')}</b>}{compact ? t.short : t.name}</span>
  </li>)}
</ul>
