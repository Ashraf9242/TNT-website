---
import {whatsappHref, labels, type Lang, type Slug} from '../data/site';
import WhatsAppIcon from './WhatsAppIcon.astro';
interface Props { lang: Lang }
const {lang} = Astro.props;
const ar = lang === 'ar';
const services: Slug[] = ['maintenance', 'cleaning', 'installation', 'contracts'];
---
<div class="whatsapp-contact">
  <div class="contact-intro">
    <span class="contact-kicker">TNT · {ar ? 'مسقط، سلطنة عُمان' : 'Muscat, Oman'}</span>
    <h2>{ar ? 'راحتك تبدأ برسالة.' : 'Comfort starts with a message.'}</h2>
    <p>{ar ? 'صيانة، تنظيف أو تركيب؟ أخبرنا بما تحتاجه على واتساب، ودع فريقنا يساعدك.' : 'Maintenance, cleaning or installation? Tell us what you need on WhatsApp and let our team help.'}</p>
    <a class="whatsapp-button" href={whatsappHref()}>
      <WhatsAppIcon size={24}/>
      {ar ? 'ابدأ المحادثة على واتساب' : 'Start a WhatsApp chat'}
    </a>
    <p class="contact-note">{ar ? 'محادثة مباشرة مع فريق TNT' : 'Chat directly with the TNT team'}</p>
  </div>
  <div class="contact-services">
    <h3>{ar ? 'كيف نقدر نساعدك؟' : 'How can we help?'}</h3>
    <p>{ar ? 'اختر الخدمة لبدء رسالة جاهزة على واتساب.' : 'Choose a service to open a prepared WhatsApp message.'}</p>
    <div class="contact-service-grid">
      {services.map((service, i) => <a class="contact-service" href={whatsappHref((ar ? 'السلام عليكم، أرغب في الاستفسار عن خدمة ' : 'Hello, I would like to enquire about ') + labels[lang][service])}>
        <span class="contact-service-number" aria-hidden="true">0{i + 1}</span>
        <span>{labels[lang][service]}</span>
        <span class="contact-service-arrow" aria-hidden="true">↗</span>
      </a>)}
    </div>
    <div class="contact-footnote"><span aria-hidden="true">◎</span><span>{ar ? 'يمكنك مشاركة موقعك وصور المكيف داخل المحادثة.' : 'You can share your location and AC photos in the chat.'}</span></div>
  </div>
</div>