---
import {clients} from '../data/content';
import type {Lang} from '../data/site';
interface Props{lang:Lang; limit?:number; big?:boolean}const {lang, limit=clients.length, big=false}=Astro.props;
---
<div class:list={['client-grid', {'client-grid--lg': big}]}>{clients.slice(0,limit).map(([id,arName,enName])=>{const name=lang==='en'&&enName?enName:arName;return <div class="client-logo">{id?<img src={`/images/client-${id}.webp`} width="210" height="110" loading="lazy" alt={name}/>:<span class="client-name">{arName}</span>}</div>})}</div>
