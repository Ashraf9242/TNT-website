---
// Hero background: photos alternate with muted work clips (cleaning / installation /
// maintenance) — 6 slides x 3s = 18s cycle. Keep the keyframe % in sync if slides change.
const slides: {type: 'img' | 'video'; name: string}[] = [
  {type: 'img', name: 'hero-service'},
  {type: 'video', name: 'hero-cleaning'},
  {type: 'img', name: 'hero-team'},
  {type: 'video', name: 'hero-install'},
  {type: 'img', name: 'technician'},
  {type: 'video', name: 'hero-maintenance'},
];
const srcset = (name: string) => `/images/${name}-480.webp 480w, /images/${name}-720.webp 720w, /images/${name}-960.webp 960w, /images/${name}-1600.webp 1600w`;
---
<div class="hero-slides" aria-hidden="true">
  {slides.map((s, index) => s.type === 'img'
    ? (index === 0
      ? <img class="hero-bg" style={`--i:${index}`} src={`/images/${s.name}-960.webp`} srcset={srcset(s.name)}
          sizes="100vw" alt="" loading="eager" fetchpriority="high" decoding="async" />
      : <img class="hero-bg" style={`--i:${index}`} data-srcset={srcset(s.name)} sizes="100vw" alt="" decoding="async" />)
    : <video class="hero-bg hero-video" style={`--i:${index}`} muted loop playsinline preload="none" data-poster={`/videos/${s.name}.jpg`} data-src={`/videos/${s.name}.mp4`}></video>
  )}
</div>
<script>
  // Only the first slide loads up front (it is the LCP image). The other photos and the clips
  // load after the page has finished loading, well before their 3s turn in the cycle.
  const heroVideos = document.querySelectorAll<HTMLVideoElement>('.hero-video');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const loadRest = () => {
    document.querySelectorAll<HTMLImageElement>('.hero-slides img[data-srcset]').forEach(img => { img.srcset = img.dataset.srcset!; });
    heroVideos.forEach(v => {
      v.poster = v.dataset.poster!;
      if (still) return;
      v.src = v.dataset.src!;
      // Rewind each clip as its slide fades in, so every pass shows the chosen opening shot.
      const rewind = () => { v.currentTime = 0; v.play().catch(() => {}); };
      v.addEventListener('animationstart', rewind);
      v.addEventListener('animationiteration', rewind);
      rewind();
    });
  };
  if (document.readyState === 'complete') loadRest(); else addEventListener('load', loadRest, {once: true});
</script>
<style>
  .hero-slides { position: absolute; inset: 0; z-index: -2; }
  .hero-slides .hero-bg { z-index: auto; object-position: 50% 57%; opacity: 0; animation: hero-cycle 18s ease-in-out infinite; animation-delay: calc(var(--i) * 3s - .6s); }
  .hero-slides .hero-bg:first-child { opacity: 1; }
  .hero-slides .hero-bg:nth-child(5) { object-position: 50% 38%; }
  .hero-video { width: 100%; height: 100%; object-fit: cover; }
  @keyframes hero-cycle {
    0% { opacity: 0; }
    3.333%, 16.667% { opacity: 1; }
    20%, 100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-slides .hero-bg { animation: none; }
  }
</style>
