---
// Service-area page body. Coverage facts mirror faq.ts; see data/areas.ts.
import {wilayats, neighbourhoods, areasCopy} from '../data/areas';
import {href, labels, whatsappHref, ui, type Lang, type Slug} from '../data/site';
interface Props {lang: Lang}
const {lang} = Astro.props;
const c = areasCopy(lang);
const i = lang === 'ar' ? 0 : 1;
const serviceLinks: Slug[] = ['installation', 'maintenance', 'cleaning', 'contracts', 'pricing'];
---
<section class="section"><div class="wrap areas">
  <p class="lead">{c.lead}</p>
  <div class="areas-grid">
    <div class="area-block">
      <h2>{c.wilayatsH}</h2><p>{c.wilayatsP}</p>
      <ul class="area-chips">{wilayats.map(w => <li>{w[i]}</li>)}</ul>
    </div>
    <div class="area-block">
      <h2>{c.barkaH}</h2><p>{c.barkaP}</p>
    </div>
  </div>
  <div class="subsection">
    <h2>{c.hoodsH}</h2><p>{c.hoodsP}</p>
    <ul class="area-chips area-chips--soft">{neighbourhoods.map(n => <li>{n[i]}</li>)}</ul>
  </div>
  <div class="areas-grid subsection">
    <div class="area-block">
      <h2>{c.farH}</h2><p>{c.farP}</p>
      <ul class="check-list">{c.far.map(f => <li>{f}</li>)}</ul>
    </div>
    <div class="area-block">
      <h2>{c.howH}</h2>
      <ul class="check-list">{c.how.map(h => <li>{h}</li>)}</ul>
    </div>
  </div>
  <div class="subsection">
    <h2>{c.servicesH}</h2>
    <nav class="related-links" aria-label={c.servicesH}>{serviceLinks.map(s => <a class="text-link" href={href(lang, s)}>{labels[lang][s]} ↗</a>)}</nav>
  </div>
  <div class="actions" style="margin-top:36px;justify-content:center"><a class="btn-96" href={whatsappHref(c.whatsapp)}><span>{c.cta}</span></a></div>
  <p class="areas-note"><a class="text-link" href={href(lang, 'contact')}>{ui[lang].quote} ↗</a></p>
</div></section>
