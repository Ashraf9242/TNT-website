---
interface Props { name: string; alt: string; hero?: boolean; class?: string; }
const {name,alt,hero=false,class:className=''}=Astro.props;
---
<img class={className} src={`/images/${name}-960.webp`} srcset={`/images/${name}-480.webp 480w, /images/${name}-960.webp 960w, /images/${name}-1600.webp 1600w`} sizes={hero?'(max-width: 767px) 100vw, 65vw':'(max-width: 767px) 100vw, 50vw'} width="1600" height="1067" alt={alt} loading={hero?'eager':'lazy'} fetchpriority={hero?'high':'auto'} decoding="async" />
