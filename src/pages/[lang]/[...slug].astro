---
import Layout from '../../layouts/Layout.astro';import Home from '../../components/Home.astro';import Photo from '../../components/Photo.astro';import Services from '../../components/Services.astro';import Stats from '../../components/Stats.astro';import Clients from '../../components/Clients.astro';import QuoteForm from '../../components/QuoteForm.astro';import Pricing from '../../components/Pricing.astro';import FaqPage from '../../components/FaqPage.astro';import FaqPreview from '../../components/FaqPreview.astro';import ServiceVideos from '../../components/ServiceVideos.astro';import Corporate from '../../components/Corporate.astro';import AcTypes from '../../components/AcTypes.astro';
import {whatsappHref,slugs,labels,ui,href,activeLanguages,type Lang,type Slug} from '../../data/site';
import {about,vision,why,whyDetails,services,systems,contractsDescriptionEn,products,text,photoAlt} from '../../data/content';
const lang=Astro.params.lang as Lang;const slug=(Astro.params.slug||'') as Slug;
if(!['ar','en'].includes(lang)||!slugs.includes(slug)){return Astro.redirect('/404')}
if(!activeLanguages.includes(lang)){return Astro.redirect(href('ar',slug)+Astro.url.search,302)}
const ar=lang==='ar';const t=ui[lang];const service=services(lang).find(s=>s.slug===slug);
const title=slug===''?(ar?text(1,1):'TNT Air Conditioning'):slug==='systems'?(ar?text(9,0):'Types of ACs we work with'):service?service.title:labels[lang][slug];
const descriptions:Partial<Record<Slug,string>>={about:about(lang),services:ar?text(7,14):'Our main services',contracts:ar?'نظام متكامل لإدارة أعطال التكييف في المباني والمؤسسات: صيانة وقائية، متابعة الأعطال، وتقارير، والتواصل مباشرة عبر واتساب.':contractsDescriptionEn,systems:systems(lang).join(' · '),clients:ar?text(6,0):'Our clients',pricing:text(10,ar?0:1),faq:ar?'إجابات واضحة لأكثر الأسئلة التي تصلنا عن المكيفات والتنظيف والصيانة والأسعار والحجز.':'Clear answers to the questions we get most about ACs, cleaning, maintenance, pricing and booking.',contact:t.quote};
const description=service?.description||descriptions[slug]||(ar?text(7,16):text(1,3));
---
<Layout lang={lang} slug={slug} title={title} description={description}>
{slug===''?<Home lang={lang}/>:<>
<section class="page-heading"><div class="wrap"><nav class="breadcrumb" aria-label={ar?'مسار التصفح':'Breadcrumb'}><a href={href(lang)}>{labels[lang]['']}</a><span aria-hidden="true">/</span><span aria-current="page">{labels[lang][slug]}</span></nav><h1>{title}</h1>{service&&<p class="lead">{service.description}</p>}</div></section>
{slug==='about'&&<><section class="section"><div class="wrap"><div class="split-layout"><div class="body-copy"><h2>{ar?text(2,0):'Who we are'}</h2><p>{about(lang)}</p><a class="btn-96" href={whatsappHref()}><span>{t.quote}</span></a></div><Photo name="team" alt={photoAlt('team',lang)} hero/></div><div class="subsection intro-grid"><h2>{text(3,ar?0:3)}</h2><p class="body-copy">{vision(lang)}</p></div></div></section><section class="section soft"><div class="wrap why-grid"><h2>{text(5,ar?6:7)}</h2><div class="why-items">{why(lang).map((s,i)=><div class="why-item"><span>{String(i+1).padStart(2,'0')}</span><h3>{s}</h3><p>{whyDetails(lang)[i]}</p></div>)}</div></div></section><section class="section"><div class="wrap"><div class="section-heading"><div><h2>{ar?text(6,0):'Our clients'}</h2></div><a class="text-link" href={href(lang,'clients')}>{t.details}</a></div><Clients lang={lang} limit={8} big/></div></section></>}
{slug==='services'&&<section class="section"><div class="wrap"><Services lang={lang} level="h2"/><div class="subsection"><div class="section-heading"><h2>{ar?'منتجاتنا':'Our products'}</h2></div><div class="gallery-grid">{products.map(name=><figure class="gallery-item"><Photo name={name} alt={photoAlt(name,lang)}/></figure>)}</div></div><a class="corp-pointer" href={href(lang,'contracts')}><span><strong>{ar?'لديك مبنى أو مؤسسة؟':'Managing a building?'}</strong> {ar?'نظام متكامل لإدارة أعطال التكييف دون أن تديرها بنفسك.':'A complete system for managing AC faults, without managing them yourself.'}</span><b>{labels[lang].contracts} {ar?'←':'→'}</b></a></div></section>}
{service&&<section class="section"><div class="wrap"><div class="split-layout"><div class="body-copy"><h2>{service.title}</h2><ul class="check-list">{service.items.map(item=><li dir="auto">{item}</li>)}</ul><a class="btn-96" href={whatsappHref((ar?'أرغب في طلب عرض سعر لخدمة ':'I would like a quote for ') + service.title)}><span>{t.quote}</span></a></div><Photo name={service.image} alt={photoAlt(service.image,lang)} hero/></div><ServiceVideos slug={slug} lang={lang}/><div class="subsection"><a class="text-link" href={href(lang,'systems')}>{t.allSystems} ↗</a> <a class="text-link" href={href(lang,'contracts')}>{labels[lang].contracts} ↗</a></div></div></section>}
{slug==='contracts'&&<Corporate lang={lang}/>}
{slug==='systems'&&<section class="section"><div class="wrap"><div class="systems-intro"><p class="lead">{ar?'نخدم جميع أنواع أنظمة التكييف: تركيب وصيانة وتنظيف وإصلاح.':'We install, service, clean and repair every type of AC system.'}</p></div><AcTypes lang={lang}/><div class="actions" style="margin-top:32px;justify-content:center"><a class="btn-96" href={whatsappHref(ar?'السلام عليكم، أرغب في الاستفسار عن أنظمة التكييف':'Hello, I would like to ask about AC systems')}><span>{t.quote}</span></a></div></div></section>}
{slug==='clients'&&<section class="section"><div class="wrap"><Clients lang={lang} big/></div></section>}
{slug==='pricing'&&<section class="section"><div class="wrap"><Pricing lang={lang}/></div></section>}
{slug==='faq'&&<section class="section"><div class="wrap"><FaqPage lang={lang}/></div></section>}
{slug==='contact'&&<section class="section"><div class="wrap"><FaqPreview lang={lang}/><QuoteForm lang={lang}/></div></section>}
</>}
</Layout>
