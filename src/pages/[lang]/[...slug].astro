---
import Layout from '../../layouts/Layout.astro';import Home from '../../components/Home.astro';import Photo from '../../components/Photo.astro';import Services from '../../components/Services.astro';import Stats from '../../components/Stats.astro';import Clients from '../../components/Clients.astro';import QuoteForm from '../../components/QuoteForm.astro';
import {slugs,labels,ui,href,activeLanguages,type Lang,type Slug} from '../../data/site';
import {about,vision,why,services,systems,contracts,prices,products,text,photoAlt} from '../../data/content';
const lang=Astro.params.lang as Lang;const slug=(Astro.params.slug||'') as Slug;
if(!['ar','en'].includes(lang)||!slugs.includes(slug)){return Astro.redirect('/404')}
if(!activeLanguages.includes(lang)){return Astro.redirect(href('ar',slug)+Astro.url.search,302)}
const ar=lang==='ar';const t=ui[lang];const service=services(lang).find(s=>s.slug===slug);
const title=slug===''?(ar?text(1,1):text(1,4)):slug==='systems'?text(9,ar?0:8):service?service.title:labels[lang][slug];
const descriptions:Partial<Record<Slug,string>>={about:about(lang),services:text(7,ar?14:15),contracts:contracts.description,systems:systems(lang).join(' · '),clients:text(6,ar?0:1),pricing:text(10,ar?0:1),contact:t.quote};
const description=service?.description||descriptions[slug]||(ar?text(7,16):text(1,3));
---
<Layout lang={lang} slug={slug} title={title} description={description}>
{slug===''?<Home lang={lang}/>:<>
<section class="page-heading"><div class="wrap"><nav class="breadcrumb" aria-label={ar?'مسار التصفح':'Breadcrumb'}><a href={href(lang)}>{labels[lang]['']}</a><span aria-hidden="true">/</span><span aria-current="page">{labels[lang][slug]}</span></nav><h1>{title}</h1>{service&&<p class="lead">{service.description}</p>}</div></section>
{slug==='about'&&<><section class="section"><div class="wrap"><div class="split-layout"><div class="body-copy"><h2>{text(2,ar?0:2)}</h2><p>{about(lang)}</p><a class="btn-96" href={href(lang,'contact')}><span>{t.quote}</span></a></div><Photo name="team" alt={photoAlt('team',lang)} hero/></div><Stats lang={lang}/><div class="subsection intro-grid"><h2>{text(3,ar?0:3)}</h2><p class="body-copy">{vision(lang)}</p></div></div></section><section class="section soft"><div class="wrap why-grid"><h2>{text(5,ar?6:7)}</h2><div class="why-items">{why(lang).map((s,i)=><div class="why-item"><span>{String(i+1).padStart(2,'0')}</span><p>{s}</p></div>)}</div></div></section></>}
{slug==='services'&&<section class="section"><div class="wrap"><Services lang={lang} level="h2"/><div class="subsection"><div class="section-heading"><h2>{ar?'منتجاتنا':'Our products'}</h2></div><div class="gallery-grid">{products.map(name=><figure class="gallery-item"><Photo name={name} alt={photoAlt(name,lang)}/></figure>)}</div></div><div class="subsection contract-section" style="padding:35px"><div class="section-heading"><h2>{labels[lang].contracts}</h2><a class="button" href={href(lang,'contracts')}>{t.details} ↗</a></div><p class="original-arabic" lang="ar" dir="rtl">{contracts.description}</p></div></div></section>}
{service&&<section class="section"><div class="wrap"><div class="split-layout"><div class="body-copy"><h2>{service.title}</h2><ul class="check-list">{service.items.map(item=><li dir="auto">{item}</li>)}</ul><a class="btn-96" href={`${href(lang,'contact')}?service=${service.slug}`}><span>{t.quote}</span></a></div><Photo name={service.image} alt={photoAlt(service.image,lang)} hero/></div><div class="subsection"><a class="text-link" href={href(lang,'systems')}>{t.allSystems} ↗</a> <a class="text-link" href={href(lang,'contracts')}>{labels[lang].contracts} ↗</a></div></div></section>}
{slug==='contracts'&&<section class="section"><div class="wrap split-layout"><div class="body-copy"><div class="original-arabic" lang="ar" dir="rtl"><p>{contracts.description}</p><ul class="check-list">{contracts.items.map(item=><li>{item}</li>)}</ul></div>{!ar&&<a class="text-link" href={href('ar','contracts')}>{t.sourceArabic} ↗</a>}<div><a class="btn-96" href={`${href(lang,'contact')}?service=contracts`}><span>{t.quote}</span></a></div></div><Photo name="workshop" alt={photoAlt('workshop',lang)} hero/></div></section>}
{slug==='systems'&&<section class="section"><div class="wrap systems-layout"><div><div class="systems-gallery"><Photo name="maintenance" alt={photoAlt('maintenance',lang)} hero/><Photo name="installation" alt={photoAlt('installation',lang)}/><Photo name="workshop" alt={photoAlt('workshop',lang)}/><Photo name="tools" alt={photoAlt('tools',lang)}/></div><div class="actions" style="margin-top:25px"><a class="btn-96" href={href(lang,'contact')}><span>{t.quote}</span></a></div></div><div class="system-list">{systems(lang).map((s,i)=><div class="system-row"><span class="system-number">0{i+1}</span><h2 style="font-size:24px">{s}</h2></div>)}<a class="text-link" href={href(lang,'installation')}>{labels[lang].installation} / Chillers ↗</a></div></div></section>}
{slug==='clients'&&<section class="section"><div class="wrap"><Clients big/></div></section>}
{slug==='pricing'&&<section class="section"><div class="wrap"><table class="price-table"><caption class="eyebrow" style="text-align:start">{text(10,ar?0:1)}</caption><thead><tr><th scope="col">{ar?text(10,3):'Service'}</th><th scope="col">{ar?text(10,2):'Price'}</th></tr></thead><tbody>{prices.map(p=><tr><td dir="auto">{p.service}</td><td><bdi>{p.price}</bdi></td></tr>)}</tbody></table><div class="actions" style="margin-top:32px"><a class="btn-96" href={href(lang,'contact')}><span>{t.quote}</span></a></div></div></section>}
{slug==='contact'&&<section class="section"><div class="wrap"><QuoteForm lang={lang}/></div></section>}
</>}
</Layout>
