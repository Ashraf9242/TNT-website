---
// AC care guide article. Content lives in src/data/guides.ts.
import Layout from '../../../layouts/Layout.astro';
import Photo from '../../../components/Photo.astro';
import GuideCards from '../../../components/GuideCards.astro';
import {guideBySlug, guides} from '../../../data/guides';
import {href, labels, whatsappHref, activeLanguages, type Lang} from '../../../data/site';
import {photoAlt} from '../../../data/content';
const lang = Astro.params.lang as Lang;
const guide = guideBySlug(Astro.params.guide ?? '');
if (!['ar', 'en'].includes(lang) || !guide) return Astro.redirect('/404');
if (!activeLanguages.includes(lang)) return Astro.redirect(href('ar', 'guides/' + guide.slug), 302);
const ar = lang === 'ar';
const g = guide[lang];
const more = guides.filter(x => x.slug !== guide.slug).slice(0, 3);
---
<Layout lang={lang} slug="guides" title={g.title} description={g.description} image={`${guide.image}-1600.webp`}
  page={{path: 'guides/' + guide.slug, title: g.seoTitle, description: g.description, image: `${guide.image}-1600.webp`, date: guide.date}}>
<section class="page-heading"><div class="wrap">
  <nav class="breadcrumb" aria-label={ar ? 'مسار التصفح' : 'Breadcrumb'}><a href={href(lang)}>{labels[lang]['']}</a><span aria-hidden="true">/</span><a href={href(lang, 'guides')}>{labels[lang].guides}</a><span aria-hidden="true">/</span><span aria-current="page">{g.title}</span></nav>
  <h1>{g.title}</h1>
  <p class="lead">{g.intro}</p>
</div></section>
<section class="section"><div class="wrap">
  <article class="article">
    <Photo name={guide.image} alt={photoAlt(guide.image, lang)}/>
    {g.sections.map(s => <section>
      <h2>{s.h}</h2>
      {s.p?.map(p => <p>{p}</p>)}
      {s.list && <ul class="check-list">{s.list.map(li => <li>{li}</li>)}</ul>}
    </section>)}
    <div class="article-cta">
      <a class="btn-96" href={whatsappHref((ar ? 'السلام عليكم، قرأت مقال: ' : 'Hello, I read your guide: ') + g.title)}><span>{g.cta}</span></a>
      <nav class="related-links" aria-label={ar ? 'خدمات ذات صلة' : 'Related services'}>{guide.related.map(s => <a class="text-link" href={href(lang, s)}>{labels[lang][s]} ↗</a>)}<a class="text-link" href={href(lang, 'areas')}>{labels[lang].areas} ↗</a></nav>
    </div>
  </article>
  <GuideCards lang={lang} items={more} heading={ar ? 'مقالات أخرى' : 'More guides'}/>
  <nav class="related-links subsection" aria-label={ar ? 'روابط' : 'Links'}><a class="text-link" href={href(lang, 'guides')}>{ar ? 'جميع المقالات' : 'All guides'} ↗</a><a class="text-link" href={href(lang, 'faq')}>{labels[lang].faq} ↗</a></nav>
</div></section>
</Layout>
