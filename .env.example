# Preview remains noindex until both switches are true and the real URL is set.
PUBLIC_SITE_URL=
PUBLIC_ALLOW_INDEXING=false
PUBLIC_CONTENT_APPROVED=false
# SMTP is server-only. Use an authenticated TLS mail service.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
QUOTE_TO=tntacservices@gmail.com
# Needed behind a trusted proxy for per-client limits; do not trust public proxy headers.
TRUST_PROXY=false
